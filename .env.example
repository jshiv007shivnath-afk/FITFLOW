# ==============================================================================
# FitFlow Environment Variables Template (.env.example)
# ==============================================================================

# Database
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Authentication
BETTER_AUTH_SECRET=fitflow-production-ultra-secret-key-2026-auth
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Brevo (Sendinblue) Transactional Email API (Primary - 300 free/day)
BREVO_API_KEY=xkeysib-your-key-here
BREVO_SENDER_EMAIL=your-verified-email@gmail.com
BREVO_SENDER_NAME="FITFLOW"

# Resend API Key (Fallback)
RESEND_API_KEY=
EMAIL_FROM="FitFlow Support <your-verified-email@gmail.com>"

# Nodemailer / Local SMTP Fallback
SMTP_HOST=127.0.0.1
SMTP_PORT=54325
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
