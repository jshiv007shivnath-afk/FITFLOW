# Database: PostgreSQL 17 via local Supabase Docker
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Better Auth Configuration (100% Standalone & Decoupled)
BETTER_AUTH_SECRET=your-secret-key-at-least-32-chars
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Production Email Delivery via Resend (Free 3,000 emails/month)
# Sign up at https://resend.com and paste your API key here (or in Vercel Environment Variables)
RESEND_API_KEY=re_your_resend_api_key_here

# Local Nodemailer / Supabase Mailpit (Port 54325) Fallback
SMTP_HOST=127.0.0.1
SMTP_PORT=54325
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="FitFlow Support <onboarding@resend.dev>"
